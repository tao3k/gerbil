;;; -*- Gerbil -*-
;;; © Gerbil contributors
;;; Maybe return consumers — shared source and native checks.
(import :std/test :std/interface "maybe-provider"
        (only-in :gerbil/runtime/error contract-violation-error?))
(export #t)

(def (class-guard (x : :t))
  (let (value (item-result x))
    (if value (list (Item? value) (: value Item)) #f)))
(def (view-guard (x : :t))
  (let (value (view-result x))
    (if value (list (View? value) (View value)) #f)))
(def (class-open (x : :t)) (: (item-result x) Item))
(def (view-open (x : :t)) (View (view-result x)))
(def (class-predicate-guard (x : :t))
  (let (value (item-result x))
    (if (Item? value) (list (Item? value) (: value Item)) #f)))
(def (view-predicate-guard (x : :t))
  (let (value (view-result x))
    (if (View? value) (list (View? value) (View value)) #f)))

(def (main)
  (def item (make-Item))
  (def view (View item))
  (def factory (Results (make-Factory)))
  (def calls 0)
  (def result-calls 0)
  (def (counted (value : :t)) => (Maybe @Item)
    (set! result-calls (+ result-calls 1))
    value)
  (check (counted #f) => #f)
  (check (counted item) => item)
  (check result-calls => 2)
  (check (item-result (begin (set! calls (+ calls 1)) #f)) => #f)
  (check calls => 1)
  (check (item-result item) => item)
  (check (view-result #f) => #f)
  (check (View? (view-result item)) => #t)
  (check (view-result view) => view)
  (check (inline-result #f) => #f)
  (check (View? (inline-result item)) => #t)
  (for-each
    (lambda (proc)
      (check (proc #f) => #f)
      (check (proc view) => view)
      (check (View? (proc item)) => #t)
      (check-exception (proc 123) interface-cast-error?))
    (list view-result inline-result optional-result optional-inline
          (lambda (x) (keyword-result x: x))
          (lambda (x) (keyword-inline x: x))
          (lambda (x) ((identity keyword-result) x: x))
          (lambda (x) ((identity keyword-inline) x: x))
          (lambda (x) ((lambda (x) => (Maybe @View) x) x))
          (lambda (x) {maybe (make-Factory) x})
          (lambda (x) (Results-view factory x))
          (lambda (x) (&Results-view factory x))
          (lambda (x) (Results-default factory x))
          (lambda (x) (&Results-default factory x))
          (lambda (x) (Results-keyword factory x: x))
          (lambda (x) (&Results-keyword factory x: x))
          (lambda (x) (Results-extension factory x))
          (lambda (x) ((identity Results-view) factory x))
          (lambda (x) ((identity &Results-view) factory x))
          (lambda (x) ((identity Results-keyword) factory x: x))
          (lambda (x) ((identity &Results-keyword) factory x: x))))
  (check (Results-default factory) => #f)
  (check (Results-keyword factory) => #f)
  (check (optional-result) => #f)
  (check (keyword-result) => #f)
  (check (optional-inline) => #f)
  (check (keyword-inline) => #f)
  (for-each
    (lambda (proc)
      (check (proc #f) => #f)
      (check (proc item) => item)
      (check-exception (proc 123) contract-violation-error?))
    (list item-result typed-item-result
          (lambda (x) (Results-item factory x))
          (lambda (x) (&Results-item factory x))
          (lambda (x) ((identity Results-item) factory x))))
  (check (integer-result 1) => 1)
  (check (integer-result #f) => #f)
  (check-exception ((identity integer-result) "bad") contract-violation-error?)
  (check (overlap-result #f) => #f)
  (check-exception ((identity overlap-result) "bad") contract-violation-error?)
  (check (boolean-result #f) => #f)
  (check-exception ((identity boolean-result) #t) contract-violation-error?)
  (check-exception ((identity custom-reject) #f) contract-violation-error?)
  (check-exception ((identity custom-reject) item) contract-violation-error?)
  (for-each
    (lambda (x) (check-exception (ordinary-item x) contract-violation-error?))
    '(#f))
  (check (ordinary-item item) => item)
  ;; Maybe :void is an actual union, unlike ordinary unspecified => :void.
  (check (void-result #f) => #f)
  (check (void-result (void)) => (void))
  (check-exception ((identity void-result) 42) contract-violation-error?)
  (for-each
    (lambda (proc)
      (for-each (lambda (x) (check (proc x) => x))
                (list #f (void) '() 42)))
    (list any-result ordinary-void))
  (for-each
    (lambda (x)
      (check-exception ((identity integer-result) x) contract-violation-error?)
      (check-exception ((identity void-result) x) contract-violation-error?))
    (list '() #!eof))
  (check (class-guard #f) => #f)
  (check (class-guard item) => (list #t item))
  (check (view-guard #f) => #f)
  (check (view-guard view) => (list #t view))
  (check (class-predicate-guard #f) => #f)
  (check (class-predicate-guard item) => (list #t item))
  (check (view-predicate-guard #f) => #f)
  (check (view-predicate-guard view) => (list #t view))
  (check (class-open item) => item)
  (check (view-open view) => view)
  (check-exception ((identity class-open) #f) contract-violation-error?)
  (check-exception ((identity view-open) #f) interface-cast-error?))
