;;; -*- Gerbil -*-
;;; © Gerbil contributors
;;; Checked access through nullable roots and intermediate slots.
(import :std/test :std/interface
        (only-in :gerbil/runtime/error contract-violation-error?))
(export main)

(interface Value (value))
(defclass Item ((x : :fixnum) proc raw (view :? Value)))
(defclass (ChildItem Item) ())
(defstruct Record ((x : :fixnum) proc raw))
(defmethod {value Item} (lambda (self) self.x))
(deftype @Item ChildItem)
(defclass Holder ((item :? @Item) (record :? Record) (view :? Value)))
(defclass (ChildHolder Holder) ())
(defclass Outer ((holder :? Holder)))
(defclass ClockHolder ((time :? :time)))

(def (read-base (item :? @Item)) item.x)
(def (call-base (item :? Item)) (item.proc 1))
(def (set-base! (item :? Item) value) (set! item.x value))
(def (set-base-raw! (item :? Item) value) (set! item.raw value))
(def (read-base-record (record :? Record)) record.x)
(def (call-base-record (record :? Record)) (record.proc 1))
(def (set-base-record! (record :? Record) value) (set! record.x value))
(def (set-base-record-raw! (record :? Record) value) (set! record.raw value))
(def (read-local value) (using (item value :? Item) item.x))
(def (call-local value) (using (item value :? Item) (item.proc 1)))
(def (set-local! value x) (using (item value :? Item) (set! item.raw x)))
(def (deep-base (h :? Holder)) h.item.x)
(def (call-base-view (view :? Value)) (view.value))
(def (read-base-time (time :? :time)) time.point)
(def (set-base-time! (time :? :time) value) (set! time.point value))
(def (nil-base (item :? Item)) item.?x)
(def (guarded-base (item :? Item)) (and item item.x))
(def (mutated-base (item :? Item))
  (and item (begin (set! item #f) item.x)))
(def (captured-base (item :? Item))
  (def (clear!) (set! item #f))
  (and item (begin (clear!) item.x)))

(def (read-item (h : Holder)) h.item.x)
(def (read-child (h : ChildHolder)) h.item.x)
(def (call-item (h : Holder)) (h.item.proc 1))
(def (set-item! (h : Holder) value) (set! h.item.x value))
(def (set-raw! (h : Holder) value) (set! h.item.raw value))
(def (set-view! (h : Holder) value) (set! h.item.view value))
(def (read-record (h : Holder)) h.record.x)
(def (call-record (h : Holder)) (h.record.proc 1))
(def (set-record! (h : Holder) value) (set! h.record.x value))
(def (set-record-raw! (h : Holder) value) (set! h.record.raw value))
(def (call-view (h : Holder)) (h.view.value))
(def (deep-read (o : Outer)) o.holder.item.x)
(def (deep-call (o : Outer)) (o.holder.item.proc 1))
(def (deep-view (o : Outer)) (o.holder.view.value))
(def (deep-set! (o : Outer) value) (set! o.holder.item.x value))
(def (nil-read (h : Holder)) h.item.?x)
(def (nil-call (h : Holder)) (h.item.?proc 1))
(def (nil-view (h : Holder)) (h.view.?value))
(def (nil-set! (h : Holder) value) (set! h.item.?x value))
(def (read-time (h : ClockHolder)) h.time.point)
(def (set-time! (h : ClockHolder) value) (set! h.time.point value))
(def (nil-time (h : ClockHolder)) h.time.?point)
(def (guarded (h : Holder)) (and h.item h.item.x))
(def (mutated (h : Holder))
  (and h.item (begin (set! h.item #f) h.item.x)))
(def (snapshot (h : Holder))
  (using (item h.item :? Item)
    (and item (begin (set! h.item #f) item.x))))

;; Catch only the operation, not the surrounding test assertion.
(def (rejected? thunk)
  (with-catch (lambda (e) #t) (lambda () (thunk) #f)))

(def (main)
  (def item (ChildItem x: 42 proc: (lambda (x) (+ x 42)) raw: #f view: #f))
  (def record (make-Record 42 (lambda (x) (+ x 42)) #f))
  (def empty (ChildHolder item: #f record: #f view: #f))
  (def full (ChildHolder item: item record: record view: item))
  (for-each
    (lambda (read)
      (check (rejected? (lambda () (read #f))) => #t)
      (check (read item) => 42))
    (list read-base read-local call-base-view))
  (for-each
    (lambda (call)
      (check (rejected? (lambda () (call #f))) => #t)
      (check (call item) => 43))
    (list call-base call-local))
  ;; Keep the read live across Gambit's elimination of unused pure calls.
  (for-each
    (lambda (read expected)
      (check (rejected? (lambda () (read #f))) => #t)
      (check (read record) => expected))
    (list read-base-record call-base-record) '(42 43))
  (for-each
    (lambda (set-value!)
      (check (rejected? (lambda () (set-value! #f 42))) => #t)
      (set-value! item 42))
    (list set-base! set-base-raw! set-local!))
  (for-each
    (lambda (set-value!)
      (check (rejected? (lambda () (set-value! #f 42))) => #t)
      (set-value! record 42))
    (list set-base-record! set-base-record-raw!))
  (check (Item-raw item) => 42)
  (check (Record-raw record) => 42)
  (check (rejected? (lambda () (set-base! item "bad"))) => #t)
  (check (rejected? (lambda () (set-base-record! record "bad"))) => #t)
  (check (rejected? (lambda () (deep-base #f))) => #t)
  (check (rejected? (lambda () (deep-base empty))) => #t)
  (check (deep-base full) => 42)
  (check (with-catch contract-violation-error?
                    (lambda () (nil-base #f) #f)) => #t)
  (check (nil-base item) => 42)
  (check (guarded-base #f) => #f)
  (check (guarded-base item) => 42)
  (check (rejected? (lambda () (mutated-base item))) => #t)
  (check (rejected? (lambda () (captured-base item))) => #t)
  (def time (##current-time))
  (check (rejected? (lambda () (read-base-time #f))) => #t)
  (check (rejected? (lambda () (set-base-time! #f 7.0))) => #t)
  (check (flonum? (read-base-time time)) => #t)
  (set-base-time! time 7.0)
  (check (read-base-time time) => 7.0)
  (for-each
    (lambda (read)
      (check (rejected? (lambda () (read empty))) => #t)
      (check (read full) => 42))
    (list read-item read-child read-record call-view))
  (for-each
    (lambda (call)
      (check (rejected? (lambda () (call empty))) => #t)
      (check (call full) => 43))
    (list call-item call-record))
  (for-each
    (lambda (set-value!)
      (check (rejected? (lambda () (set-value! empty 7))) => #t)
      (set-value! full 7))
    (list set-item! set-record! set-raw! set-record-raw!))
  (check (read-item full) => 7)
  (check (read-record full) => 7)
  (check (Item-raw item) => 7)
  (check (Record-raw record) => 7)
  (check (rejected? (lambda () (set-item! full "bad"))) => #t)
  (check (rejected? (lambda () (set-record! full "bad"))) => #t)
  (check (rejected? (lambda () (set-view! empty item))) => #t)
  (set-view! full item)
  (using (h full : Holder)
    (check (Value? h.item.view) => #t)
    (check (h.item.view.value) => 7))
  (set-view! full #f)
  (using (h full : Holder) (check h.item.view => #f))
  (def clock (ClockHolder time: (##current-time)))
  (def no-clock (ClockHolder time: #f))
  (check (rejected? (lambda () (read-time no-clock))) => #t)
  (check (rejected? (lambda () (set-time! no-clock 7.0))) => #t)
  (check (with-catch contract-violation-error?
                    (lambda () (nil-time no-clock) #f)) => #t)
  (check (flonum? (read-time clock)) => #t)
  (set-time! clock 7.0)
  (check (read-time clock) => 7.0)
  (check (nil-time clock) => 7.0)
  (def outer (Outer holder: full))
  (for-each
    (lambda (h)
      (def missing (Outer holder: h))
      (check (rejected? (lambda () (deep-read missing))) => #t)
      (check (rejected? (lambda () (deep-call missing))) => #t)
      (check (rejected? (lambda () (deep-view missing))) => #t)
      (check (rejected? (lambda () (deep-set! missing 9))) => #t))
    (list #f empty))
  (check (deep-read outer) => 7)
  (check (deep-call outer) => 43)
  (check (deep-view outer) => 7)
  (deep-set! outer 9)
  (check (deep-read outer) => 9)
  (for-each
    (lambda (read)
      (check (with-catch contract-violation-error?
                        (lambda () (read empty) #f)) => #t))
    (list nil-read nil-call nil-view))
  (check (with-catch contract-violation-error?
                    (lambda () (nil-set! empty 10) #f)) => #t)
  (check (nil-read full) => 9)
  (check (nil-call full) => 43)
  (check (nil-view full) => 9)
  (nil-set! full 10)
  (check (read-item full) => 10)
  (check (guarded empty) => #f)
  (check (guarded full) => 10)
  (check (rejected? (lambda () (mutated full))) => #t)
  (using (h full : Holder) (set! h.item item))
  (check (snapshot full) => 10)
  (check (guarded full) => #f))
