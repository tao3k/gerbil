;;; -*- Gerbil -*-
;;; © Gerbil contributors
;;; Nullable interface compiler regression.
(import :std/test :std/interface
        (only-in :gerbil/runtime/error contract-violation-error?))

(interface NullableValue (value))
(defstruct Value ())
(defmethod {value Value} (lambda (self) 42))

(def (required (obj : NullableValue)) obj)
(def (forward (obj :? NullableValue)) (required obj))
(def (guarded (obj :? NullableValue)) (if obj (obj.value) #f))
(def (forward-indirect (obj :? NullableValue) proc) (proc obj))

(defclass Holder ((item :? NullableValue)))
(defclass (ChildHolder Holder) ())
(defstruct RecordHolder ((item :? NullableValue)))
(defclass CustomHolder ((item :? NullableValue)) constructor: :init!)
(defmethod {:init! CustomHolder}
  (lambda (self value) (set! self.item value)))
(defclass BoxValue ((value : :fixnum)))
(deftype @BoxValue BoxValue)
(def (box-value (obj :? @BoxValue)) (if obj obj.value #f))
(def (box-required (obj : @BoxValue)) obj)
(def (box-forward (obj :? @BoxValue)) (box-required obj))
(def checks 0)
(def (count-check value) (set! checks (+ checks 1)) #t)
(def (extra-check (obj :~ count-check :? NullableValue)) obj)
(def (slot-forward (holder : Holder)) (required holder.item))
(def (set-item! (holder : Holder) value) (set! holder.item value))
(def (slot-value (holder : Holder))
  (using (obj holder.item :? NullableValue)
    (if obj (obj.value) #f)))
(def (optional (obj #f :? NullableValue)) (if obj (obj.value) #f))
(def (keyword key: (obj :? NullableValue := #f)) (if obj (obj.value) #f))
(def (not-guard (obj :? NullableValue)) (if (not obj) #f (obj.value)))
(def (double-not-guard (obj :? NullableValue)) (if (not (not obj)) (obj.value) #f))
(def (and-guard (obj :? NullableValue)) (and obj (obj.value)))
(def (or-guard (obj :? NullableValue)) (or (not obj) (obj.value)))
(def (when-guard (obj :? NullableValue)) (when obj (obj.value)))
(def (unless-guard (obj :? NullableValue)) (unless (not obj) (obj.value)))
(def (mutable-guard (obj :? NullableValue))
  (if obj
    (begin (set! obj #f) (required obj))
    #f))
(def (escaped-guard (obj :? NullableValue))
  (let (read (if obj (lambda () (required obj)) (lambda () #f)))
    (set! obj #f)
    (read)))
(def (callback-guard (obj :? NullableValue))
  (def (mutate) (set! obj #f))
  (if obj (begin (mutate) (required obj)) #f))
(def (shadow-not (obj :? NullableValue))
  (let (not (lambda (x) #t))
    (if (not obj) #f (obj.value))))
(def (snapshot-guard (obj :? NullableValue))
  (using (copy obj :? NullableValue)
    (let (read (if copy (lambda () (copy.value)) (lambda () #f)))
      (set! obj #f)
      (read))))

;; A broad exception predicate would also accept the test framework's failure.
(def (cast-rejected? thunk)
  (with-catch interface-cast-error?
	      (lambda () (thunk) #f)))

(def (main)
  (check (extra-check #f) => #f)
  (check (guarded (extra-check (make-Value))) => 42)
  (check (guarded (extra-check (NullableValue (make-Value)))) => 42)
  (check checks => 3)
  (def holder (make-ChildHolder item: #f))
  (def record (make-RecordHolder #f))
  (def custom (make-CustomHolder (make-Value)))
  (using (record : RecordHolder)
    (check record.item => #f)
    (set! record.item (make-Value))
    (check (guarded record.item) => 42)
    (set! record.item #f)
    (check record.item => #f))
  (using (custom : CustomHolder)
    (check (guarded custom.item) => 42)
    (set! custom.item #f)
    (check custom.item => #f))
  (check (box-value #f) => #f)
  (check (box-value (make-BoxValue value: 7)) => 7)
  (check (with-catch contract-violation-error? (lambda () (box-forward #f) #f)) => #t)
  (check (slot-value holder) => #f)
  (check (cast-rejected? (lambda () (slot-forward holder))) => #t)
  (set-item! holder (make-Value))
  (check (slot-value holder) => 42)
  (set-item! holder #f)
  (check (slot-value holder) => #f)
  (check (cast-rejected? (lambda () (slot-forward holder))) => #t)
  (check (optional) => #f)
  (check (optional (make-Value)) => 42)
  (check (keyword) => #f)
  (check (keyword key: (make-Value)) => 42)
  (for-each
    (lambda (proc)
      (check (proc #f) => #f)
      (check (proc (make-Value)) => 42))
    (list guarded not-guard double-not-guard and-guard))
  (check (or-guard #f) => #t)
  (check (or-guard (make-Value)) => 42)
  (check (when-guard (make-Value)) => 42)
  (check (unless-guard (make-Value)) => 42)
  (check (cast-rejected? (lambda () (mutable-guard (make-Value)))) => #t)
  (check (cast-rejected? (lambda () (escaped-guard (make-Value)))) => #t)
  (check (cast-rejected? (lambda () (callback-guard (make-Value)))) => #t)
  (check (shadow-not (make-Value)) => #f)
  (check (snapshot-guard (make-Value)) => 42)
  (check (guarded #f) => #f)
  (check (guarded (make-Value)) => 42)
  (check (guarded (NullableValue (make-Value))) => 42)
  (check
   (list
    (cast-rejected? (lambda () (forward #f)))
    (cast-rejected? (lambda () (forward-indirect #f required)))
    (cast-rejected? (lambda () (using (obj #f :? NullableValue) (required obj))))
    (cast-rejected? (lambda () (required (:? #f NullableValue)))))
   => '(#t #t #t #t)))
